# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

# --- MySQL (docker compose) ---
MYSQL_DATABASE=vetcare
MYSQL_USER=vetcare
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_PORT=3306

# --- API ---
API_PORT=8000
# local | test | staging | production. En production se desactiva /api/docs.
VETCARE_ENVIRONMENT=local
# Orígenes permitidos por CORS, en formato JSON.
VETCARE_CORS_ORIGINS=["http://localhost:5173"]

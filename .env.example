# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

# --- MySQL (docker compose) ---
MYSQL_DATABASE=vetcare
MYSQL_USER=vetcare
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_PORT=3306

# --- API ---
API_PORT=8000
# local | test | staging | production. En production se desactiva /api/docs.
VETCARE_ENVIRONMENT=local
# Orígenes permitidos por CORS, en formato JSON.
VETCARE_CORS_ORIGINS=["http://localhost:5173"]
# Firma de los access tokens: al menos 32 caracteres aleatorios. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VETCARE_JWT_SECRET=reemplaza-por-un-valor-aleatorio-de-al-menos-32-caracteres
# Base de los enlaces de activación y recuperación que se envían por correo.
VETCARE_PUBLIC_WEB_URL=http://localhost:5173
# VETCARE_DATABASE_URL y VETCARE_TEST_DATABASE_URL se arman en docker-compose.yml con las
# variables de MySQL. Defínelas aquí solo si ejecutas la API fuera de Docker, p. ej.:
# VETCARE_DATABASE_URL=mysql+asyncmy://vetcare:tu-clave@127.0.0.1:3306/vetcare

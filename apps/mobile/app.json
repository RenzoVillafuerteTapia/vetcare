{
  "expo": {
    "name": "VetCare",
    "slug": "vetcare",
    "scheme": "vetcare",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f3ef",
    "ios": {
      "bundleIdentifier": "pe.vetcare.clientes",
      "supportsTablet": true
    },
    "android": {
      "package": "pe.vetcare.clientes",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00736a"
        }
      ]
    ]
  }
}
